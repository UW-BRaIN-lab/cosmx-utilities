# CosMx analysis pipeline configuration
# Copy this file to .env and fill in your values:
#   cp pipeline/.env.example pipeline/.env

# --- Source AWS S3: where the original CosMx flat files + Seurat .RDS live ---
SOURCE_S3_BUCKET=keene-cosmx-data
SOURCE_S3_PREFIX=CosMx-GBM/Wenyu-cohort

# AWS source credentials for migrate_s3_to_kopah.py. Set one of:
#   (1) AWS_SOURCE_ACCESS_KEY_ID + AWS_SOURCE_SECRET_ACCESS_KEY (explicit), or
#   (2) AWS_SOURCE_PROFILE (named profile in ~/.aws/credentials).
# If both are empty, boto3 falls back to its default chain (~/.aws/credentials,
# env vars, instance profile). Explicit is recommended on klone where
# AWS_ACCESS_KEY_ID is set to Kopah keys by the kopah_brain shell helper.
AWS_SOURCE_ACCESS_KEY_ID=
AWS_SOURCE_SECRET_ACCESS_KEY=
AWS_SOURCE_PROFILE=

# --- UW Kopah: S3-compatible working storage for the pipeline ---
# Credentials are pre-provisioned at ~/kopah_<groupname> on klone.
KOPAH_ENDPOINT_URL=https://s3.kopah.uw.edu
KOPAH_BUCKET=brainlabkg
KOPAH_PREFIX=cosmx-gbm
KOPAH_ACCESS_KEY_ID=
KOPAH_SECRET_ACCESS_KEY=

# --- Hyak Slurm (reference; the slurm/*.sh scripts hardcode these in #SBATCH) ---
# glioblastoma has only a GPU node (gpu-l40s). CPU stages run on the free,
# preemptible ckpt partition under the glioblastoma-ckpt account.
SLURM_ACCOUNT_CPU=glioblastoma-ckpt
SLURM_PARTITION_CPU=ckpt
SLURM_QOS_CPU=ckpt
SLURM_ACCOUNT_GPU=glioblastoma
SLURM_PARTITION_GPU=gpu-l40s

# --- Apptainer container paths on Hyak (built later; see pipeline/containers/) ---
# Keep SIFs in the lab's PERSISTENT storage, NOT /gscratch/scrubbed — scrubbed
# auto-purges by last-access (~21 days) and will silently delete an idle SIF, breaking
# the next run. Build cache/tmp may stay on scrubbed. The lab has no group-writable
# shared container dir (/gscratch/glioblastoma/containers is one member's, read-only to
# the group), so build into your own /gscratch/glioblastoma/$USER/containers (the lab
# root is group-writable). $USER expands when this file is sourced.
# APPTAINER_RSC        rapids-singlecell + dask-cuda (stage 1 CPU + stage 3c GPU)
# APPTAINER_SCPEARSON  R / scPearsonPCA (stage 3b batch Pearson-residual PCA, CPU)
# APPTAINER_INSITUTYPE R / InSituType + InSituTree (stage 4 cell typing)
# APPTAINER_INSITUCNV  Python / infercnvpy + Moldia InSituCNV (stage 5 copy-number, CPU)
APPTAINER_RSC=/gscratch/glioblastoma/$USER/containers/rapids-singlecell.sif
APPTAINER_SCPEARSON=/gscratch/glioblastoma/$USER/containers/scpearsonpca.sif
APPTAINER_INSITUTYPE=/gscratch/glioblastoma/$USER/containers/insitutype.sif
APPTAINER_INSITUCNV=/gscratch/glioblastoma/$USER/containers/insitucnv.sif

# --- Stage 3 QC + PCA + clustering knobs (optional; Slurm scripts have defaults) ---
# STAGE3_DIR=stage3       Kopah sub-prefix for stage 3 outputs; override (e.g.
#                         stage3_q100) to run a parallel variant without
#                         overwriting an existing run. Applies to 20/30/40/50.
# MIN_GENE_COUNTS=50      per-cell gene-count floor (6k panel)
# MAX_AREA=30000          per-cell area ceiling, pixels
# MAX_NEGPROBE_PROP=0.1   per-cell negprobe fraction ceiling
# BATCH_COL=Case          obs column used as the PCA batch (patient-level; 3a)
# BATCH_VARIABLE=Case     same batch column name, passed to the R PCA stage (3b)
# COHORT=pipeline/cohort_wenyu.csv  cohort (Donor,Block) table; 3a keeps only these
#                                   tissues (set empty to keep all co-mounted donors)
# N_HVG=2000              highly variable genes for PCA (6k panel)
# NPCS=50                 PCA components
# SCALE_MAX=10            Pearson-residual clip, in SDs
# RESOLUTION=1.2          Leiden resolution
# N_NEIGHBORS=15          kNN graph neighbors
# QC_COLOR=Case,Region,leiden  obs keys for the 3c UMAP QC plots
# --- Marker heatmap (50_marker_heatmap.sh; render with pipeline/R/marker_heatmap.R) ---
# GROUP_KEY=leiden        obs column to group cells by (swap to cell_type post-InSituType)
# TOP_N=5                 top markers per cluster
# MIN_GROUP_N=10          drop cluster x Region groups smaller than this
# CLUSTERED_BASENAME=cosmx_clustered.h5ad  which clustered AnnData to read; for the
#                         cell-type heatmap set cosmx_typed.h5ad (with STAGE3_DIR=stage4
#                         GROUP_KEY=cell_type).
# CLUSTERS=               optional comma-separated subset of group-key values to show
#                         markers for (e.g. the de novo InSituType letters
#                         a,b,c,d,e,f,g,h,i,j,k,l); differential is still vs all clusters.

# --- Stage 4 InSituType cell typing (70/80/90; R driver pipeline/R/insitutype_typing.R) ---
# STAGE4_DIR=stage4       Kopah sub-prefix for stage 4 outputs (parallels STAGE3_DIR).
# INPUT_DIR=              prefix to READ insitutype_input.h5 from (default: STAGE4_DIR).
#                         For a variant run reuse the shared input without duplicating
#                         the multi-GB file: INPUT_DIR=stage4 STAGE4_DIR=stage4_refit.
# REFERENCE_BASENAME=gbmap_level4_panel.csv  panel-restricted GBmap reference on Kopah
#                         at ${KOPAH_PREFIX}/reference/ (see pipeline/reference/README.md).
# N_CLUSTS=10:20          de novo clusters ADDED to the named GBmap types; a range lets
#                         InSituType auto-select the optimal number within it.
# UPDATE_REFERENCE=true   adapt the scRNA-seq reference to the CosMx data (recommended).
# RESCALE=true            gene-level platform correction (gentle; preserves de novo clusters)
# REFIT=false             refit every gene x type to anchors (aggressive; off by default here)
# REFINEMENT=false        further anchor refinement
# N_STARTS=10             InSituType random starts
# MAX_ITERS=40            InSituType max EM iterations
# QC_COLOR can include cell_type post-typing for the 3c-style UMAP QC plots.

# --- Stage 5 InSituCNV copy-number inference (86/87/88; Python, APPTAINER_INSITUCNV) ---
# Tests whether the InSituTree Low_signal cells (no transcriptional identity) are tumour
# via the GBM CNV signature (chr7 gain / chr10 loss). Per tissue block (slide x donor x block).
# STAGE5_DIR=stage5_insitucnv   Kopah sub-prefix for stage-5 outputs.
# MIN_CELLS=500                 prep: skip tissue sections smaller than this (compare: 200)
# MIN_REF_CELLS=50              prep: skip sections with too few diploid-reference cells
# N_NEIGHBORS=20                spatial neighbors for the smoothing graph (run + 86b; keep in
#                               sync). Lower than InSituCNV's default: heavy smoothing
#                               contaminates the reference in diffusely-infiltrating GBM.
# WINDOW_SIZE=100  STEP=10  DYNAMIC_THRESHOLD=1.5   infercnv params (run)
# REFERENCE_VECTOR=reference_vector.csv  87 auto-uses the pooled diploid reference built by
#                               86b (contralateral cells) if present; set to 'none' to force
#                               the per-section reference_cat fallback.
# The diploid reference cell types are pipeline/reference/insitucnv_reference_types.txt.
# Stage order: 86 prep -> 86b build reference -> 87 array (--array=0-N) -> 88 compare.
