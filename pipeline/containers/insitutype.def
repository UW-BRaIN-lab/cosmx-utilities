Bootstrap: docker
From: rocker/r-ver:4.4.2

# Apptainer runtime for stage 4 cell typing (R, CPU). Ships two typing engines:
#   - InSituType: semi-supervised typing against the CZI GBmap reference (de novo
#     discovery). Driver R/insitutype_typing.R.
#   - InSituTree: supervised, hierarchical typing against a user-defined cell-type
#     hierarchy + profile matrix (no de novo — forces a label, flag low prob).
#     Driver R/insitutree_typing.R.
# This is a CPU/R stage — it runs on the free, preemptible `ckpt` partition, NOT
# gpu-l40s. InSituType phase-subsamples internally and InSituTree runs one supervised
# insitutypeML pass per hierarchy node, so the 2.3M-cell cohort is tractable on a
# big-memory CPU node; the embedding/clustering GPU work is stage 3c, separate.
#
# It is its own SIF (not folded into scpearsonpca.sif) because InSituType pulls a large
# Bioconductor + tidyverse dependency tree that has no business in the lean PCA image.
#
# Reproducibility (same scheme as scpearsonpca.def): R is pinned by the
# rocker/r-ver:4.4.2 base, CRAN packages come from a DATED Posit Package Manager
# snapshot (CRAN_SNAPSHOT), Bioconductor is pinned to the release matching R 4.4
# (BIOC_VERSION 3.20), and InSituType is pinned to a commit SHA. Bump all three
# together and rebuild to move forward.
#
# Build from the repo root on a klone login node (Apptainer + fakeroot), with
# cache/tmp on /gscratch (home is only 10GB):
#     cd ~/cosmx-utilities
#     export APPTAINER_CACHEDIR=/gscratch/scrubbed/$USER/apptainer-cache
#     export APPTAINER_TMPDIR=/gscratch/scrubbed/$USER/apptainer-tmp
#     apptainer build --fakeroot \
#         /gscratch/scrubbed/$USER/containers/insitutype.sif \
#         pipeline/containers/insitutype.def

%post -c /bin/bash
    set -euxo pipefail

    export DEBIAN_FRONTEND=noninteractive

    # The klone login node caps processes per user (RLIMIT_NPROC ~1024). R's OpenBLAS
    # otherwise spins one thread per core (48 on klone) and install.packages(Ncpus=N)
    # compiles N packages at once — together they blow past the cap with "Cannot fork"
    # (InSituType pulls ~47 deps, so this bites here where the lean scpearsonpca image
    # was fine). Pin BLAS to one thread and cap parallel compiles; harmless in a build.
    export OPENBLAS_NUM_THREADS=1
    export OMP_NUM_THREADS=1
    export MAKEFLAGS="-j4"

    # System libs: libhdf5-dev for hdf5r (reads the stage-4a .h5), libxml2/zlib for the
    # usual build toolchain, and the font/image stack that ggplot2's graphics deps
    # (an InSituType import) compile against.
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        libhdf5-dev \
        libxml2-dev \
        zlib1g-dev \
        libpng-dev \
        libjpeg-dev \
        libtiff5-dev \
        libfontconfig1-dev \
        libfreetype6-dev \
        libharfbuzz-dev \
        libfribidi-dev
    rm -rf /var/lib/apt/lists/*

    # InSituType's src/Makevars pins CXX_STD = CXX11, but the RcppArmadillo in this CRAN
    # snapshot dropped C++11 and requires C++14+ (Armadillo's compiler_check.hpp errors
    # under -std=gnu++11). Redirect R's "C++11 mode" to gnu++17 site-wide so the
    # package's CXX11 request compiles against the newer Armadillo; C++11 sources are
    # forward-compatible with C++17.
    echo 'CXX11STD = -std=gnu++17' >> "$(Rscript -e 'cat(R.home("etc"))')/Makevars.site"

    # Frozen CRAN snapshot — pins every CRAN package version to this date. Matches the
    # date used by scpearsonpca.def so both R images draw from the same proven snapshot.
    CRAN_SNAPSHOT="https://packagemanager.posit.co/cran/__linux__/jammy/2026-05-27"
    # Bioconductor release paired with R 4.4.
    BIOC_VERSION="3.20"

    # CRAN dependencies of InSituType (see its DESCRIPTION Imports) plus hdf5r for our
    # driver and the remotes/BiocManager installers. spatstat.geom is CRAN (not Bioc).
    # jsonlite parses the InSituTree hierarchy JSON; stringr is InSituTree's only Import
    # not already pulled in by InSituType.
    Rscript -e "options(repos = c(CRAN = '${CRAN_SNAPSHOT}'), Ncpus = 4); \
        install.packages(c('data.table', 'dplyr', 'fastglm', 'ggplot2', 'irlba', 'lsa', \
            'magrittr', 'Matrix', 'mclust', 'Rcpp', 'RcppArmadillo', 'rlang', 'scales', \
            'spatstat.geom', 'tibble', 'umap', 'uwot', 'hdf5r', 'jsonlite', 'stringr', \
            'remotes', 'BiocManager'))"

    # Bioconductor dependencies, pinned to the BIOC_VERSION release repos.
    Rscript -e "BiocManager::install(c('SingleCellExperiment', 'SummarizedExperiment', \
        'sparseMatrixStats'), version = '${BIOC_VERSION}', update = FALSE, ask = FALSE)"

    # InSituType from GitHub, pinned to a commit SHA for reproducibility. Dependencies
    # are already installed above, so don't let remotes upgrade them off the snapshot.
    # This SHA is InSituType 2.0, which exports insitutypeML (InSituTree's engine).
    Rscript -e "options(repos = c(CRAN = '${CRAN_SNAPSHOT}')); \
        remotes::install_github('Nanostring-Biostats/InSituType', \
            ref = 'f3ef0dd0814318d74675e6a613fad3ef7f1e23a1', \
            upgrade = 'never', dependencies = FALSE)"

    # InSituTree (supervised, hierarchical typing) lives in a subdir of the CosMx
    # Analysis Scratch Space MONOREPO, which also carries an unrelated `_code/smiDE` git
    # submodule. remotes::install_github clones with --recurse-submodules and HANGS on a
    # git credential prompt trying to fetch that submodule (it needs auth) — even though
    # InSituTree has no dependency on it. So clone WITHOUT submodules, check out the
    # pinned SHA, and install the subdir locally. GIT_TERMINAL_PROMPT=0 makes any stray
    # auth prompt fail fast instead of hanging the build. Depends on InSituType (>= 2.0,
    # satisfied above) + stringr (installed above).
    export GIT_TERMINAL_PROMPT=0
    git clone --no-recurse-submodules \
        https://github.com/Nanostring-Biostats/CosMx-Analysis-Scratch-Space.git \
        /tmp/scratch-space
    git -C /tmp/scratch-space checkout 1760ea2d565fa56e0cdc5b6e959d4e4cc8f191bd
    Rscript -e "options(repos = c(CRAN = '${CRAN_SNAPSHOT}')); \
        remotes::install_local('/tmp/scratch-space/_code/InSituTree', \
            upgrade = 'never', dependencies = FALSE)"
    rm -rf /tmp/scratch-space

    # Build-time import check: load every package the stage-4 drivers need and confirm
    # the InSituType + InSituTree entry points exist.
    Rscript -e "library(Matrix); library(data.table); library(hdf5r); library(jsonlite); \
        library(InSituType); library(InSituTree); \
        stopifnot(is.function(InSituType::insitutype), \
                  is.function(InSituType::refineClusters), \
                  is.function(InSituType::insitutypeML), \
                  is.function(InSituTree::runInSituTree)); \
        cat('InSituType + InSituTree ok\n')"

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec Rscript "$@"

%labels
    org.opencontainers.image.source https://github.com/UW-BRaIN-lab/cosmx-utilities
    org.opencontainers.image.description CosMx GBM pipeline runtime — R, InSituType (semi-supervised) + InSituTree (hierarchical) cell typing
    pipeline.stage insitutype
