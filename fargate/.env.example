# Fargate infrastructure configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-west-2
ECS_CLUSTER=cosmx-fargate
S3_BUCKET=your-bucket-name
FARGATE_SUBNETS=subnet-xxxxx,subnet-yyyyy
FARGATE_SECURITY_GROUP=sg-xxxxx

# The stopped EC2 instance holding the raw atlas H5ADs the combined InSituType reference was
# built from (us-west-2). See pipeline/RETINA_TYPING.md, "Applying a merge". Its data volume
# is DeleteOnTermination=true, so snapshot it before depending on it.
REFERENCE_BUILD_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
